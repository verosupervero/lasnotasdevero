  function lesson1(d) { return d.blocks.keys().hasOnly(["los-evangelios-como-biografias-antiguas","la-transmision-de-las-ensenanzas","el-proposito-de-lucas"]) && (!('los-evangelios-como-biografias-antiguas' in d.blocks) || (boolLeaf(d.blocks["los-evangelios-como-biografias-antiguas"]))) && (!('la-transmision-de-las-ensenanzas' in d.blocks) || (boolLeaf(d.blocks["la-transmision-de-las-ensenanzas"]))) && (!('el-proposito-de-lucas' in d.blocks) || (boolLeaf(d.blocks["el-proposito-de-lucas"]))) && (!('lastPoint' in d) || (stringLeaf(d.lastPoint) && d.lastPoint.value in ["video-2","-video-2--por-qué-leer-el-evangelio-de-lucas","1-los-evangelios-como-biografías-antiguas","2-la-transmisión-de-las-enseñanzas","3-el-propósito-de-lucas"])); }
  function lesson2(d) { return d.blocks.keys().hasOnly(["dos-anunciaciones-un-mensaje","el-magnificat-y-la-historia-de-israel-lucas-14655","la-logica-del-reino-la-gran-inversion","el-espiritu-santo-como-protagonista","nacimiento-de-juan-y-profecia-de-zacarias","pesebre-pastores-y-tradiciones","simeon-ana-y-salvacion-para-las-naciones","como-cuenta-lucas-la-historia"]) && (!('dos-anunciaciones-un-mensaje' in d.blocks) || (boolLeaf(d.blocks["dos-anunciaciones-un-mensaje"]))) && (!('el-magnificat-y-la-historia-de-israel-lucas-14655' in d.blocks) || (boolLeaf(d.blocks["el-magnificat-y-la-historia-de-israel-lucas-14655"]))) && (!('la-logica-del-reino-la-gran-inversion' in d.blocks) || (boolLeaf(d.blocks["la-logica-del-reino-la-gran-inversion"]))) && (!('el-espiritu-santo-como-protagonista' in d.blocks) || (boolLeaf(d.blocks["el-espiritu-santo-como-protagonista"]))) && (!('nacimiento-de-juan-y-profecia-de-zacarias' in d.blocks) || (boolLeaf(d.blocks["nacimiento-de-juan-y-profecia-de-zacarias"]))) && (!('pesebre-pastores-y-tradiciones' in d.blocks) || (boolLeaf(d.blocks["pesebre-pastores-y-tradiciones"]))) && (!('simeon-ana-y-salvacion-para-las-naciones' in d.blocks) || (boolLeaf(d.blocks["simeon-ana-y-salvacion-para-las-naciones"]))) && (!('como-cuenta-lucas-la-historia' in d.blocks) || (boolLeaf(d.blocks["como-cuenta-lucas-la-historia"]))) && (!('lastPoint' in d) || (stringLeaf(d.lastPoint) && d.lastPoint.value in ["video-3","-video-3--lucas-12-el-anuncio-y-nacimiento-de-jesús","-bibliografía-y-fuentes-utilizadas-en-este-video","1-dos-anunciaciones-un-mensaje","2-el-magníficat-y-la-historia-de-israel-lucas-14655","3-la-lógica-del-reino-la-gran-inversión","4-el-espíritu-santo-como-protagonista","5-nacimiento-de-juan-y-profecia-de-zacarias","6-pesebre-pastores-y-tradiciones","7-simeon-ana-y-salvacion-para-las-naciones","8-como-cuenta-lucas-la-historia"])); }
  function lesson3(d) { return d.blocks.keys().hasOnly(["que-dice-lucas-sobre-el-censo-lucas-215","el-problema-cronologico-de-quirinio","por-que-jose-y-maria-viajaron-a-belen","historia-fuentes-e-interpretacion","belen-miqueas-y-los-relatos-del-nacimiento","pregunta-final-de-integracion"]) && (!('que-dice-lucas-sobre-el-censo-lucas-215' in d.blocks) || (boolLeaf(d.blocks["que-dice-lucas-sobre-el-censo-lucas-215"]))) && (!('el-problema-cronologico-de-quirinio' in d.blocks) || (boolLeaf(d.blocks["el-problema-cronologico-de-quirinio"]))) && (!('por-que-jose-y-maria-viajaron-a-belen' in d.blocks) || (boolLeaf(d.blocks["por-que-jose-y-maria-viajaron-a-belen"]))) && (!('historia-fuentes-e-interpretacion' in d.blocks) || (boolLeaf(d.blocks["historia-fuentes-e-interpretacion"]))) && (!('belen-miqueas-y-los-relatos-del-nacimiento' in d.blocks) || (boolLeaf(d.blocks["belen-miqueas-y-los-relatos-del-nacimiento"]))) && (!('pregunta-final-de-integracion' in d.blocks) || (boolLeaf(d.blocks["pregunta-final-de-integracion"]))) && (!('lastPoint' in d) || (stringLeaf(d.lastPoint) && d.lastPoint.value in ["censo-lucas-2","-estudio-complementario--fue-real-el-censo-de-lucas-2","1-qué-dice-lucas-sobre-el-censo-lucas-215","2-el-problema-cronológico-de-quirinio","3-por-qué-josé-y-maría-viajaron-a-belén","4-historia-fuentes-e-interpretación","5-belén-miqueas-y-los-relatos-del-nacimiento","6-pregunta-final-de-integración"])); }
  function lesson4(d) { return d.blocks.keys().hasOnly(["historia-real-mensaje-concreto-lucas-3120","el-bautismo-de-jesus-lucas-32122","la-genealogia-mas-alla-de-israel-lucas-32338","las-tentaciones-en-el-desierto-lucas-4113","jesus-en-nazaret-la-proclamacion-de-su-mision-lucas-41430","la-autoridad-de-jesus-en-capernaum-lucas-43141","el-reino-de-dios-y-la-mision-de-jesus-lucas-44244"]) && (!('historia-real-mensaje-concreto-lucas-3120' in d.blocks) || (boolLeaf(d.blocks["historia-real-mensaje-concreto-lucas-3120"]))) && (!('el-bautismo-de-jesus-lucas-32122' in d.blocks) || (boolLeaf(d.blocks["el-bautismo-de-jesus-lucas-32122"]))) && (!('la-genealogia-mas-alla-de-israel-lucas-32338' in d.blocks) || (boolLeaf(d.blocks["la-genealogia-mas-alla-de-israel-lucas-32338"]))) && (!('las-tentaciones-en-el-desierto-lucas-4113' in d.blocks) || (boolLeaf(d.blocks["las-tentaciones-en-el-desierto-lucas-4113"]))) && (!('jesus-en-nazaret-la-proclamacion-de-su-mision-lucas-41430' in d.blocks) || (boolLeaf(d.blocks["jesus-en-nazaret-la-proclamacion-de-su-mision-lucas-41430"]))) && (!('la-autoridad-de-jesus-en-capernaum-lucas-43141' in d.blocks) || (boolLeaf(d.blocks["la-autoridad-de-jesus-en-capernaum-lucas-43141"]))) && (!('el-reino-de-dios-y-la-mision-de-jesus-lucas-44244' in d.blocks) || (boolLeaf(d.blocks["el-reino-de-dios-y-la-mision-de-jesus-lucas-44244"]))) && (!('lastPoint' in d) || (stringLeaf(d.lastPoint) && d.lastPoint.value in ["video-4","-video-4--lucas-34-comienzo-del-ministerio-de-jesús","1-historia-real-mensaje-concreto-lucas-3120","2-el-bautismo-de-jesús-lucas-32122","3-la-genealogía-más-allá-de-israel-lucas-32338","4-las-tentaciones-en-el-desierto-lucas-4113","5-jesús-en-nazaret-la-proclamación-de-su-misión-lucas-41430","6-la-autoridad-de-jesús-en-capernaúm-lucas-43141","7-el-reino-de-dios-y-la-misión-de-jesús-lucas-44244"])); }
  function lesson5(d) { return d.blocks.keys().hasOnly(["lucas-como-historiador-y-teologo","la-gran-inversion-en-accion","fundamento-para-la-mision-hoy"]) && (!('lucas-como-historiador-y-teologo' in d.blocks) || (boolLeaf(d.blocks["lucas-como-historiador-y-teologo"]))) && (!('la-gran-inversion-en-accion' in d.blocks) || (boolLeaf(d.blocks["la-gran-inversion-en-accion"]))) && (!('fundamento-para-la-mision-hoy' in d.blocks) || (boolLeaf(d.blocks["fundamento-para-la-mision-hoy"]))) && (!('lastPoint' in d) || (stringLeaf(d.lastPoint) && d.lastPoint.value in ["integracion","-parte-final--integración","1-lucas-como-historiador-y-teólogo","2-la-gran-inversión-en-acción","3-fundamento-para-la-misión-hoy"])); }
