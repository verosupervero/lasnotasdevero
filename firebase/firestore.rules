// Generated from firebase/courses.json and the unchanged study Markdown.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true && request.auth.token.firebase.sign_in_provider == 'google.com'; }
  function unlocked(uid) { return !exists(/databases/$(database)/documents/students/$(uid)); }
  function clock(t) { return t is int && t >= 0 && t <= request.time.toMillis() + 300000; }
  function leaf(d) { return d is map && d.keys().hasOnly(['value','updatedAt']) && d.keys().hasAll(['value','updatedAt']) && clock(d.updatedAt); }
  function boolLeaf(d) { return leaf(d) && d.value is bool; }
  function numberLeaf(d) { return leaf(d) && clock(d.value); }
  function stringLeaf(d) { return leaf(d) && d.value is string && d.value.size() <= 200; }
  function generation(g) { return g is string && g.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'); }
  function known(course) { return course in ["lucas"]; }
  function header(d, course) { return d.keys().hasOnly(['schema','revision','generation','resetCount','deleted','updatedAt','selected','lastActivity']) && d.keys().hasAll(['schema','revision','generation','resetCount','deleted','updatedAt']) && d.schema == 1 && d.revision is int && d.revision >= 1 && d.revision <= 2147483647 && d.resetCount is int && d.resetCount >= 0 && d.resetCount <= d.revision && d.deleted is bool && generation(d.generation) && d.updatedAt == request.time && (!('lastActivity' in d) || (numberLeaf(d.lastActivity))) && ((course == "lucas" && (!('selected' in d) || (stringLeaf(d.selected) && d.selected.value in ["video-1","video-2","video-3","censo-lucas-2","video-4","integracion","video-5","video-6","lucas-1-6-cierre-practico"])))) && (!d.deleted || (!('selected' in d) && !('lastActivity' in d))); }
  function transition(d, old) { return d.revision == old.revision + 1 && ((d.deleted && d.resetCount == old.resetCount + 1 && d.generation != old.generation) || (!d.deleted && d.resetCount == old.resetCount && d.generation == old.generation)); }
  function lesson0(d) { return d.blocks.keys().hasOnly(["historia-y-fe","adoracion-y-mision","el-centro-del-mensaje-cristiano-1-corintios-15","una-historia-que-todavia-continua","una-biblioteca-distintos-generos-literarios","una-fe-para-todos-ensenanza-y-transmision","los-primeros-cristianos-en-el-mundo-grecorromano","del-testimonio-apostolico-a-los-credos-historicos","la-paradoja-de-un-mesias-crucificado","el-espiritu-santo-la-mision-y-la-comunidad"]) && (!('historia-y-fe' in d.blocks) || (boolLeaf(d.blocks["historia-y-fe"]))) && (!('adoracion-y-mision' in d.blocks) || (boolLeaf(d.blocks["adoracion-y-mision"]))) && (!('el-centro-del-mensaje-cristiano-1-corintios-15' in d.blocks) || (boolLeaf(d.blocks["el-centro-del-mensaje-cristiano-1-corintios-15"]))) && (!('una-historia-que-todavia-continua' in d.blocks) || (boolLeaf(d.blocks["una-historia-que-todavia-continua"]))) && (!('una-biblioteca-distintos-generos-literarios' in d.blocks) || (boolLeaf(d.blocks["una-biblioteca-distintos-generos-literarios"]))) && (!('una-fe-para-todos-ensenanza-y-transmision' in d.blocks) || (boolLeaf(d.blocks["una-fe-para-todos-ensenanza-y-transmision"]))) && (!('los-primeros-cristianos-en-el-mundo-grecorromano' in d.blocks) || (boolLeaf(d.blocks["los-primeros-cristianos-en-el-mundo-grecorromano"]))) && (!('del-testimonio-apostolico-a-los-credos-historicos' in d.blocks) || (boolLeaf(d.blocks["del-testimonio-apostolico-a-los-credos-historicos"]))) && (!('la-paradoja-de-un-mesias-crucificado' in d.blocks) || (boolLeaf(d.blocks["la-paradoja-de-un-mesias-crucificado"]))) && (!('el-espiritu-santo-la-mision-y-la-comunidad' in d.blocks) || (boolLeaf(d.blocks["el-espiritu-santo-la-mision-y-la-comunidad"]))) && (!('lastPoint' in d) || (stringLeaf(d.lastPoint) && d.lastPoint.value in ["video-1","-video-1--por-qué-estudiar-el-nuevo-testamento","1-historia-y-fe","2-adoración-y-misión","3-el-centro-del-mensaje-cristiano-1-corintios-15","4-una-historia-que-todavía-continúa","5-una-biblioteca-distintos-g