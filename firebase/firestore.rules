  function lesson7(d) { return d.blocks.keys().hasOnly(["lucas6-eleccion-de-los-doce","lucas6-multitud-y-sermon-del-llano","lucas6-bienaventuranzas-y-ayes","lucas6-profetas-y-falsos-profetas","lucas6-amor-a-los-enemigos","lucas6-no-juzgar-y-ciego","lucas6-arbol-y-fruto","lucas6-senor-senor-y-cimientos","lucas6-integracion-seguidores-del-camino"]) && (!('lucas6-eleccion-de-los-doce' in d.blocks) || (boolLeaf(d.blocks["lucas6-eleccion-de-los-doce"]))) && (!('lucas6-multitud-y-sermon-del-llano' in d.blocks) || (boolLeaf(d.blocks["lucas6-multitud-y-sermon-del-llano"]))) && (!('lucas6-bienaventuranzas-y-ayes' in d.blocks) || (boolLeaf(d.blocks["lucas6-bienaventuranzas-y-ayes"]))) && (!('lucas6-profetas-y-falsos-profetas' in d.blocks) || (boolLeaf(d.blocks["lucas6-profetas-y-falsos-profetas"]))) && (!('lucas6-amor-a-los-enemigos' in d.blocks) || (boolLeaf(d.blocks["lucas6-amor-a-los-enemigos"]))) && (!('lucas6-no-juzgar-y-ciego' in d.blocks) || (boolLeaf(d.blocks["lucas6-no-juzgar-y-ciego"]))) && (!('lucas6-arbol-y-fruto' in d.blocks) || (boolLeaf(d.blocks["lucas6-arbol-y-fruto"]))) && (!('lucas6-senor-senor-y-cimientos' in d.blocks) || (boolLeaf(d.blocks["lucas6-senor-senor-y-cimientos"]))) && (!('lucas6-integracion-seguidores-del-camino' in d.blocks) || (boolLeaf(d.blocks["lucas6-integracion-seguidores-del-camino"]))) && (!('lastPoint' in d) || (stringLeaf(d.lastPoint) && d.lastPoint.value in ["video-6","video-6-lucas-6-12-49","eleccion-de-los-doce","multitud-y-sermon-del-llano","bienaventuranzas-y-ayes","profetas-y-falsos-profetas","amor-a-los-enemigos","no-juzgar-y-ciego","arbol-y-fruto","senor-senor-y-cimientos","integracion-seguidores-del-camino"])); }
  function lesson8(d) { return d.blocks.keys().hasOnly(["aplicacion-fiel-al-texto","zacarias-elisabet-y-la-oracion","maria-y-el-valor-de-las-personas","pastores-y-testigos-inesperados","simeon-y-ana-el-servicio","juan-tentaciones-y-obediencia","jesus-sanidades-discipulado-y-oracion","cuando-los-milagros-no-ocurren","oracion-ayuda-concreta-y-plan"]) && (!('aplicacion-fiel-al-texto' in d.blocks) || (boolLeaf(d.blocks["aplicacion-fiel-al-texto"]))) && (!('zacarias-elisabet-y-la-oracion' in d.blocks) || (boolLeaf(d.blocks["zacarias-elisabet-y-la-oracion"]))) && (!('maria-y-el-valor-de-las-personas' in d.blocks) || (boolLeaf(d.blocks["maria-y-el-valor-de-las-personas"]))) && (!('pastores-y-testigos-inesperados' in d.blocks) || (boolLeaf(d.blocks["pastores-y-testigos-inesperados"]))) && (!('simeon-y-ana-el-servicio' in d.blocks) || (boolLeaf(d.blocks["simeon-y-ana-el-servicio"]))) && (!('juan-tentaciones-y-obediencia' in d.blocks) || (boolLeaf(d.blocks["juan-tentaciones-y-obediencia"]))) && (!('jesus-sanidades-discipulado-y-oracion' in d.blocks) || (boolLeaf(d.blocks["jesus-sanidades-discipulado-y-oracion"]))) && (!('cuando-los-milagros-no-ocurren' in d.blocks) || (boolLeaf(d.blocks["cuando-los-milagros-no-ocurren"]))) && (!('oracion-ayuda-concreta-y-plan' in d.blocks) || (boolLeaf(d.blocks["oracion-ayuda-concreta-y-plan"]))) && (!('lastPoint' in d) || (stringLeaf(d.lastPoint) && d.lastPoint.value in ["lucas-1-6-cierre-practico","aplicacion-fiel-al-texto","zacarias-elisabet-y-la-oracion","maria-y-el-valor-de-las-personas","pastores-y-testigos-inesperados","simeon-y-ana-el-servicio","juan-tentaciones-y-obediencia","jesus-sanidades-discipulado-y-oracion","cuando-los-milagros-no-ocurren","oracion-ayuda-concreta-y-plan"])); }
  function classData(d, course, lesson) { return d.keys().hasOnly(['schema','generation','blocks','complete','lastPoint','lastActivity']) && d.keys().hasAll(['schema','generation','blocks']) && d.schema == 1 && generation(d.generation) && d.blocks is map && (!('complete' in d) || (boolLeaf(d.complete))) && (!('lastActivity' in d) || (numberLeaf(d.lastActivity))) && ((course == "lucas" && lesson == "video-1" && lesson0(d)) || (course == "lucas" && lesson == "video-2" && lesson1(d)) || (course == "lucas" && lesson == "video-3" && lesson2(d)) || (course == "lucas" && lesson == "censo-lucas-2" && lesson3(d)) || (course == "lucas" && lesson == "video-4" && lesson4(d)) || (course == "lucas" && lesson == "integracion" && lesson5(d)) || (course == "lucas" && lesson == "video-5" && lesson6(d)) || (course == "lucas" && lesson == "video-6" && lesson7(d)) || (course == "lucas" && lesson == "lucas-1-6-cierre-practico" && lesson8(d))); }
  match /students/{uid} {
   allow read: if owner(uid);
   allow create: if owner(uid) && request.resource.data.keys().hasOnly(['schema','erasedAt']) && request.resource.data.schema == 1 && request.resource.data.erasedAt == request.time;
   allow update, delete: if false;
   match /guides/{course} {
    allow read: if owner(uid) && known(course);
    allow create: if owner(uid) && unlocked(uid) && known(course) && header(request.resource.data, course) && request.resource.data.revision == 1 && request.resource.data.resetCount == (request.resource.data.deleted ? 1 : 0);
    allow update: if owner(uid) && unlocked(uid) && known(course) && header(request.resource.data, course) && transition(request.resource.data, resource.data);
    allow delete: if owner(uid) && !unlocked(uid);
    match /classes/{lesson} {
     allow read: if owner(uid) && known(course);
     allow create, update: if owner(uid) && unlocked(uid) && classData(request.resource.data, course, lesson) && !getAfter(/databases/$(database)/documents/students/$(uid)/guides/$(course)).data.deleted && request.resource.data.generation == getAfter(/databases/$(database)/documents/students/$(uid)/guides/$(course)).data.generation && getAfter(/databases/$(database)/documents/students/$(uid)/guides/$(course)).data.updatedAt == request.time;
     allow delete: if owner(uid) && (!unlocked(uid) || (getAfter(/databases/$(database)/documents/students/$(uid)/guides/$(course)).data.deleted && getAfter(/databases/$(database)/documents/students/$(uid)/guides/$(course)).data.updatedAt == request.time));
    }
   }
  }
 }
}
