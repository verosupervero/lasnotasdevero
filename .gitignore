# Hugo files to ignore

# Generated public site
/public/
/resources/_gen/

# Temporary files
.DS_Store
Thumbs.db

# Node modules (if you use npm/yarn in your Hugo project)
/node_modules/
/.contact-test-output/
/yarn.lock

# Hugo cache and temp
.hugo_build.lock

# OS and IDE junk
.idea/
.vscode/
*.swp
*.swo

# Backup files
*~
*.bak

# Private Lucas synchronization credentials, encrypted backups and generated manifests
/.lucas-private/
/.env
/.env.*
!/.env.example
/netlify/generated/

# Firebase bundles, emulator dependencies and private local runtime state
/static/js/study-firebase.bundle.js
/static/js/study-firebase.LICENSE.txt
/static/js/vendor/html2canvas-1.4.1.min.js
/static/js/vendor/html2canvas-1.4.1.LICENSE.txt
/firebase/generated/
/tools/firebase/node_modules/
/tools/firebase/.cache/
/firebase/*-debug.log
/firebase/.firebase/
/tools/firebase/*-debug.log
